<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="r18FJ_iF5zA)31Lc@fFU" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="^v(#`OTrz,1N1bc0K0JJ"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MyEnum {" line1="    //% block=&quot;one&quot;" line2="    One," line3="    //% block=&quot;two&quot;" line4="    Two" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="Vug$M7YA|SBI{By(vrRh"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace 循跡車 {" line1="    /**" line2="     * TODO: describe your function here" line3="     * @param n describe parameter here, eg: 5" line4="     * @param s describe parameter here, eg: &quot;Hello&quot;" line5="     * @param e describe parameter here" line6="     */" line7="    let IR_MID_PIN = DigitalPin.P1" line8="    let IR_LEFT_PIN = DigitalPin.P4" line9="    let IR_RIGHT_PIN = DigitalPin.P10" line10="    let LeftSpeed = 0" line11="    let RightSpeed = 0" line12="    let StraightLineSpeed = 150" line13="    let IrMidIsBlack = false" line14="    let IrLeftIsBlack = false" line15="    let IrRightIsBlack = false" line16="" line17="    //% block=&quot;中間有黑線&quot;" line18="    export function 中間有黑線(): boolean {" line19="        return (IrMidIsBlack == true)" line20="    }" line21="    //% block=&quot;左邊有黑線&quot;" line22="    export function 左邊有黑線(): boolean {" line23="        return (IrLeftIsBlack == true)" line24="    }" line25="    //% block=&quot;右邊有黑線&quot;" line26="    export function 右邊有黑線(): boolean {" line27="        return (IrRightIsBlack == true)" line28="    }" line29="" line30="    //% block=&quot;中間沒黑線&quot;" line31="    export function 中間沒黑線(): boolean {" line32="        return (IrMidIsBlack == false)" line33="    }" line34="    //% block=&quot;左邊沒黑線&quot;" line35="    export function 左邊沒黑線(): boolean {" line36="        return (IrLeftIsBlack == false)" line37="    }" line38="    //% block=&quot;右邊沒黑線&quot;" line39="    export function 右邊沒黑線(): boolean {" line40="        return (IrRightIsBlack == false)" line41="    }" line42="" line43="    //% block=&quot;啟用循跡車&quot;" line44="    export function 啟用循跡車() {" line45="        led.enable(false)" line46="        pins.setPull(IR_MID_PIN, PinPullMode.PullNone)" line47="        pins.setPull(IR_LEFT_PIN, PinPullMode.PullNone)" line48="        pins.setPull(IR_RIGHT_PIN, PinPullMode.PullNone)" line49="    }" line50="    //% block=&quot;更新感測值&quot;" line51="    export function 更新感測值() {" line52="        IrMidIsBlack = (pins.digitalReadPin(IR_MID_PIN) == 1) ? true : false" line53="        IrLeftIsBlack = (pins.digitalReadPin(IR_LEFT_PIN) == 1) ? true : false" line54="        IrRightIsBlack = (pins.digitalReadPin(IR_RIGHT_PIN) == 1) ? true : false" line55="    }" line56="    //% block=&quot;直行&quot;" line57="    export function 直行() {" line58="        LeftSpeed = StraightLineSpeed" line59="        RightSpeed = StraightLineSpeed" line60="    }" line61="    //% block=&quot;往左微調&quot;" line62="    export function 往左微調() {" line63="        LeftSpeed = StraightLineSpeed - 30" line64="        RightSpeed = StraightLineSpeed + 30" line65="    }" line66="    //% block=&quot;往右微調&quot;" line67="    export function 往右微調() {" line68="        LeftSpeed = StraightLineSpeed + 30" line69="        RightSpeed = StraightLineSpeed - 30" line70="    }" line71="    //% block=&quot;往左修正&quot;" line72="    export function 往左修正() {" line73="        LeftSpeed = StraightLineSpeed - 100" line74="        RightSpeed = StraightLineSpeed + 100" line75="    }" line76="    //% block=&quot;往右修正&quot;" line77="    export function 往右修正() {" line78="        LeftSpeed = StraightLineSpeed + 90" line79="        RightSpeed = StraightLineSpeed - 90" line80="    }" line81="    //% block=&quot;馬達控制&quot;" line82="    export function 馬達控制() {" line83="        YbExtend.MotorRun(YbExtend.enMotors.M1, LeftSpeed);" line84="        YbExtend.MotorRun(YbExtend.enMotors.M3, RightSpeed);" line85="    }" line86="}" numlines="87"></mutation><next><block type="typescript_statement" id="(V9Hs{[@gUH^%GoS/(p6"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace YbExtend {" line1="" line2="    const PCA9685_ADD = 0x40" line3="    const MODE1 = 0x00" line4="    const PRESCALE = 0xFE" line5="    let initialized = false" line6="" line7="    export enum enMotors {" line8="        M1 = 8," line9="        M2 = 10," line10="        M3 = 12," line11="        M4 = 14" line12="    }" line13="" line14="    function i2cwrite(addr: number, reg: number, value: number) {" line15="        let buf = pins.createBuffer(2)" line16="        buf[0] = reg" line17="        buf[1] = value" line18="        pins.i2cWriteBuffer(addr, buf)" line19="    }" line20="    function i2cread(addr: number, reg: number) {" line21="        pins.i2cWriteNumber(addr, reg, NumberFormat.UInt8BE);" line22="        let val = pins.i2cReadNumber(addr, NumberFormat.UInt8BE);" line23="        return val;" line24="    }" line25="    function initPCA9685(): void {" line26="        i2cwrite(PCA9685_ADD, MODE1, 0x00)" line27="        setFreq(50);" line28="        initialized = true" line29="    }" line30="" line31="    function setFreq(freq: number): void {" line32="        // Constrain the frequency" line33="        let prescaleval = 25000000;" line34="        prescaleval /= 4096;" line35="        prescaleval /= freq;" line36="        prescaleval -= 1;" line37="        let prescale = prescaleval; //Math.Floor(prescaleval + 0.5);" line38="        let oldmode = i2cread(PCA9685_ADD, MODE1);" line39="        let newmode = (oldmode &amp; 0x7F) | 0x10; // sleep" line40="        i2cwrite(PCA9685_ADD, MODE1, newmode); // go to sleep" line41="        i2cwrite(PCA9685_ADD, PRESCALE, prescale); // set the prescaler" line42="        i2cwrite(PCA9685_ADD, MODE1, oldmode);" line43="        control.waitMicros(5000);" line44="        i2cwrite(PCA9685_ADD, MODE1, oldmode | 0xa1);" line45="    }" line46="" line47="    function setPwm(channel: number, on: number, off: number): void {" line48="        if (channel &lt; 0 || channel &gt; 15)" line49="            return;" line50="        if (!initialized) {" line51="            initPCA9685();" line52="        }" line53="        let buf2 = pins.createBuffer(5);" line54="        buf2[0] = 0x06 + 4 * channel;" line55="        buf2[1] = on &amp; 0xff;" line56="        buf2[2] = (on &gt;&gt; 8) &amp; 0xff;" line57="        buf2[3] = off &amp; 0xff;" line58="        buf2[4] = (off &gt;&gt; 8) &amp; 0xff;" line59="        pins.i2cWriteBuffer(PCA9685_ADD, buf2);" line60="    }" line61="" line62="    export function MotorRun(index: enMotors, speed: number): void {" line63="        if (!initialized) {" line64="            initPCA9685()" line65="        }" line66="        speed = speed * 16; // map 255 to 4096" line67="        if (speed &gt;= 4096) {" line68="            speed = 4095" line69="        }" line70="        if (speed &lt;= -4096) {" line71="            speed = -4095" line72="        }" line73="" line74="        let a = index" line75="        let b = index + 1" line76="" line77="        if (a &gt; 10) {" line78="            if (speed &gt;= 0) {" line79="                setPwm(a, 0, speed)" line80="                setPwm(b, 0, 0)" line81="            } else {" line82="                setPwm(a, 0, 0)" line83="                setPwm(b, 0, -speed)" line84="            }" line85="        }" line86="        else {" line87="            if (speed &gt;= 0) {" line88="                setPwm(b, 0, speed)" line89="                setPwm(a, 0, 0)" line90="            } else {" line91="                setPwm(b, 0, 0)" line92="                setPwm(a, 0, -speed)" line93="            }" line94="        }" line95="    }" line96="}" numlines="97"></mutation></block></next></block></next></block></statement></block></xml>